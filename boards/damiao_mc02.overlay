/* This file will automatic applyed when using damiao_mc02 board */

/ {
    remote: remote0 {
        status = "okay";
        compatible = "rp,remote";
        uart = <&uart5>;
    };
    aliases {
        remote0 = &remote;
    };

    can_rx_mgr1: can_rx_mgr1 {
        compatible = "rp,can-rx-manager";
        status = "okay";
        can-bus = <&fdcan1>;
        label = "can_rx_mgr1";
    };

    can_tx_mgr1: can_tx_mgr1 {
        compatible = "rp,can-tx-manager";
        status = "okay";
        can-bus = <&fdcan1>;
        label = "can_tx_mgr1";
    };

    can_tx_mgr2: can_tx_mgr2 {
        compatible = "rp,can-tx-manager";
        status = "okay";
        can-bus = <&fdcan2>;
        label = "can_tx_mgr2";
    };

    can_rx_mgr2: can_rx_mgr2 {
        compatible = "rp,can-rx-manager";
        status = "okay";
        can-bus = <&fdcan2>;
        label = "can_rx_mgr2";
    };

};

/ {
    aliases {
        watchdog0 = &iwdg;  /* 将 watchdog0 指向 IWDG 硬件 */
    };
};

&iwdg {
    status = "okay"; /* 启用独立看门狗 IWDG */
};


&gpioc {
	/* 板载可控电源使能：PC15 高电平开电
	 * gpio-hog：Zephyr 在 POST_KERNEL 自动把该引脚配成输出并拉高，
	 * 早于 main()，不需要任何电源管理代码。
	 */
	imu_vcc: imu-vcc {
		gpio-hog;
		gpios = <15 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "imu_vcc";
	};
};

&usart10 {
	current-speed = <2000000>;
};
